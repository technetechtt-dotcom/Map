# Environment variables (copy to `.env` — never commit secrets)

# Database (local SQLite)
DATABASE_URL="file:./dev.db"

# Auth (required)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Seed administrators (required to create users on seed)
SEED_ADMIN_PASSWORD=""
# SEED_ADMIN_EMAIL="admin@ictmap.gov.za"
# SEED_NC_ADMIN_EMAIL="nc.admin@ictmap.gov.za"
# SEED_ORG_ADMIN_EMAIL="org@dedat.example"

# Local non-production demo only (never in production)
# ALLOW_DEMO_USERS=1
# NEXT_PUBLIC_DEMO_HINTS=1

# Encrypted backups (super-admin)
BACKUP_ENCRYPTION_KEY=""

# CAPTCHA (required in production for /api/submissions)
# CAPTCHA_DISABLED=1
# TURNSTILE_SECRET=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# RECAPTCHA_SECRET=

# Uploads
# STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
# S3_REQUIRE=1

# Optional monitoring
# SENTRY_DSN=
