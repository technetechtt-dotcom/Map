{
  "name": "sa-ict-ecosystem-map",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:deps": "npm audit --audit-level=high",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:reset": "node -e \"if(process.env.ALLOW_DATABASE_RESET!=='1'){console.error('Set ALLOW_DATABASE_RESET=1');process.exit(1)}\" && node prisma/seed.js",
    "db:setup": "prisma generate && prisma db push",
    "db:setup:dev": "prisma generate && prisma db push && node prisma/seed.js",
    "db:migrate": "prisma migrate deploy",
    "backup:restore-test": "node scripts/restore-backup-smoke.js",
    "maps:districts": "node data/seed/crop-district-maps.js",
    "maps:mdb": "node data/seed/download-mdb-boundaries.js && node data/seed/build-mdb-maps.js",
    "maps:mdb:build": "node data/seed/build-mdb-maps.js",
    "db:studio": "prisma studio",
    "postgis:up": "docker compose up -d",
    "postgis:down": "docker compose down"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.28.0",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "next-intl": "^4.13.5",
    "papaparse": "^5.5.4",
    "prisma": "5.22.0",
    "react": "^19.2.8",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.8",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
