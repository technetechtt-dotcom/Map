{
  "name": "sa-ict-ecosystem-map",
  "version": "1.3.0",
  "private": true,
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:deps": "node scripts/ci-audit.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:reset": "node -e \"if(process.env.ALLOW_DATABASE_RESET!=='1'){console.error('Set ALLOW_DATABASE_RESET=1');process.exit(1)}\" && node prisma/seed.js",
    "db:setup": "prisma generate && prisma migrate deploy",
    "db:setup:dev": "prisma generate && prisma migrate deploy && node prisma/seed.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "backup:restore-test": "node scripts/restore-backup-smoke.js",
    "backup:pg-smoke": "node scripts/postgres-backup-smoke.js",
    "backup:dr": "node scripts/disaster-recovery-smoke.js",
    "neon:verify": "node scripts/neon-verify.js",
    "mfa:rotate": "tsx scripts/rotate-mfa-secrets.ts",
    "sbom": "node scripts/generate-sbom.js",
    "jobs:worker": "tsx scripts/job-worker.ts",
    "maps:districts": "node data/seed/crop-district-maps.js",
    "maps:mdb": "node data/seed/download-mdb-boundaries.js && node data/seed/build-mdb-maps.js",
    "maps:mdb:build": "node data/seed/build-mdb-maps.js",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@prisma/client": "5.22.0",
    "@sentry/node": "^8.55.0",
    "@swc/helpers": "0.5.23",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.28.0",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "next-intl": "^4.13.5",
    "papaparse": "^5.5.4",
    "prisma": "5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.8",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "glob": "10.5.0",
    "postcss": "$postcss",
    "@swc/helpers": "0.5.23",
    "nanoid": "^3.3.18"
  }
}
