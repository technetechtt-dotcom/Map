# Environment variables (copy to `.env` — never commit secrets)

# PostgreSQL (Neon: DATABASE_URL = pooled runtime, DIRECT_URL = unpooled migrations)
DATABASE_URL="postgresql://ictmap:ictmap_dev_password@localhost:5433/sa_ict_ecosystem?schema=public"
DIRECT_URL="postgresql://ictmap:ictmap_dev_password@localhost:5433/sa_ict_ecosystem?schema=public"
# DATABASE_MIGRATE_URL is an alias for DIRECT_URL when using least-privilege runtime roles.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string-at-least-32-chars"

SEED_ADMIN_PASSWORD=""
# SEED_ADMIN_EMAIL=admin@ictmap.gov.za
# SEED_NC_ADMIN_EMAIL=nc.admin@ictmap.gov.za
# ALLOW_DEMO_USERS=1
# NEXT_PUBLIC_DEMO_HINTS=1
# NEXT_PUBLIC_DEMO_SUPER_EMAIL=admin@ictmap.gov.za
# NEXT_PUBLIC_DEMO_PROVINCIAL_EMAIL=nc.admin@ictmap.gov.za
# ALLOW_DATABASE_RESET=1

BACKUP_ENCRYPTION_KEY=""
MFA_ENCRYPTION_KEY=""
