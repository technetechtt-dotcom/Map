# LOGIN_LOCK_MINUTES=15
# MFA_ENFORCE=1
# Local development: MFA_ENFORCE=0 (password-only). Elevated roles still require MFA in production unless this is 0.
# NEXT_PUBLIC_MFA_LOGIN=0 hides the login MFA field (also hidden automatically in `next dev`).
# MAINTENANCE_MODE=0
# HIBP_DISABLED=1
# NOTIFY_WEBHOOK_URL=
# SENTRY_DSN=
# SENTRY_RELEASE=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05

