generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  PROVINCIAL_ADMIN
  ORG_ADMIN
  CONTRIBUTOR
}

enum RecordStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ImportStatus {
  STAGED
  APPLIED
  REJECTED
}

enum WorkflowStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  REJECTED
}

enum RelationshipType {
  PARTNER_OF
  FUNDED_BY
  SUPPLIER_TO
  INCUBATED_BY
  TRAINED_BY
  MEMBER_OF
  INVESTED_IN
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  name                 String
  passwordHash         String
  role                 UserRole             @default(CONTRIBUTOR)
  provinceId           String?
  province             Province?            @relation(fields: [provinceId], references: [id])
  organisationId       String?
  organisation         Organisation?        @relation(fields: [organisationId], references: [id])
  active               Boolean              @default(true)
  locale               String               @default("en")
  sessionVersion       Int                  @default(0)
  mustChangePassword   Boolean              @default(false)
  mfaEnabled           Boolean              @default(false)
  /// AES-256-GCM ciphertext (never store plaintext TOTP secrets)
  mfaSecret            String?
  mfaKeyVersion        Int                  @default(1)
  /// Candidate secret used during explicit re-enrollment; active MFA stays valid until confirmed
  mfaPendingSecret     String?
  mfaPendingKeyVersion Int?
  /// bcrypt hashes of one-time recovery codes
  mfaRecoveryHashes    Json                 @default("[]")
  failedLoginCount     Int                  @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  auditLogs            AuditLog[]
  locationsOwned       Location[]           @relation("LocationOwner")
  locationsReviewed    Location[]           @relation("LocationReviewer")
  submissions          Submission[]         @relation("SubmissionSubmitter")
  submissionsReviewed  Submission[]         @relation("SubmissionReviewer")
  sources              SourceRecord[]
  passwordResetTokens  PasswordResetToken[]
  invitationsSent      AdminInvitation[]    @relation("InvitationInviter")
  passwordHistories    PasswordHistory[]
  organisationClaims   OrganisationClaim[]
  notifications        Notification[]
  apiKeys              ApiKey[]
  mfaRecoveryRequests  MfaRecoveryRequest[] @relation("MfaRecoverySubject")
  mfaRecoveriesOpened  MfaRecoveryRequest[] @relation("MfaRecoveryRequester")
  mfaRecoveriesApproved MfaRecoveryRequest[] @relation("MfaRecoveryApprover")

  @@index([role, active])
  @@index([provinceId])
  @@index([organisationId])
  @@index([lastLoginAt])
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model Province {
  id            String           @id @default(cuid())
  code          String           @unique
  name          String           @unique
  nameAf        String?
  nameXh        String?
  nameZu        String?
  slug          String           @unique
  centerLat     Float
  centerLng     Float
  defaultZoom   Int              @default(6)
  geojson       Json?
  districts     District[]
  locations     Location[]
  organisations Organisation[]
  fundingCalls  FundingCall[]
  events        EcosystemEvent[]
  programmes    Programme[]
  procurements  Procurement[]
  users         User[]
  submissions   Submission[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model District {
  id             String         @id @default(cuid())
  code           String
  name           String
  nameAf         String?
  provinceId     String
  province       Province       @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  geojson        Json?
  municipalities Municipality[]
  locations      Location[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([provinceId, code])
  @@index([provinceId])
}

model Municipality {
  id         String     @id @default(cuid())
  code       String
  name       String
  nameAf     String?
  districtId String
  district   District   @relation(fields: [districtId], references: [id], onDelete: Cascade)
  geojson    Json?
  locations  Location[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([districtId, code])
  @@index([districtId])
  @@index([code])
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String     @unique
  nameAf      String?
  color       String
  icon        String     @default("•")
  description String?
  locations   Location[]
}

model Location {
  id                    String         @id @default(cuid())
  slug                  String         @unique
  name                  String
  nameAf                String?
  summary               String
  summaryAf             String?
  description           String?
  latitude              Float
  longitude             Float
  categoryId            String
  category              Category       @relation(fields: [categoryId], references: [id])
  provinceId            String
  province              Province       @relation(fields: [provinceId], references: [id])
  districtId            String?
  district              District?      @relation(fields: [districtId], references: [id])
  municipalityId        String?
  municipality          Municipality?  @relation(fields: [municipalityId], references: [id])
  opportunitiesJson     Json           @default("[]")
  assetsJson            Json           @default("[]")
  tagsJson              Json           @default("[]")
  website               String?
  email                 String?
  phone                 String?
  address               String?
  imageUrl              String?
  status                RecordStatus   @default(DRAFT)
  verificationNotes     String?
  lastVerifiedAt        DateTime?
  retrievedAt           DateTime?
  sourceVersion         String?
  sourceUrl             String?
  verificationSource    String?
  coordQuality          String         @default("unknown")
  coordSource           String?
  sourceConfidence      String?
  boundaryValid         String?
  staleAt               DateTime?
  verificationExpiresAt DateTime?
  verificationTier      String         @default("unverified")
  canonicalKey          String?        @unique
  externalId            String?
  evidenceJson          Json           @default("[]")
  ownerId               String?
  owner                 User?          @relation("LocationOwner", fields: [ownerId], references: [id])
  reviewedById          String?
  reviewedBy            User?          @relation("LocationReviewer", fields: [reviewedById], references: [id])
  organisationId        String?
  organisation          Organisation?  @relation(fields: [organisationId], references: [id])
  sources               SourceRecord[]
  ingestionChanges      IngestionChange[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  publishedAt           DateTime?

  @@index([provinceId, status])
  @@index([districtId, status])
  @@index([municipalityId])
  @@index([organisationId])
  @@index([categoryId])
  @@index([verificationExpiresAt])
  @@index([createdAt])
  @@index([status])
  @@index([coordQuality])
  @@index([verificationTier])
  @@index([canonicalKey])
  @@index([externalId])
}

model Organisation {
  id                       String                     @id @default(cuid())
  slug                     String                     @unique
  name                     String
  type                     String
  description              String?
  website                  String?
  email                    String?
  phone                    String?
  logoUrl                  String?
  locationSlugsJson        Json                       @default("[]")
  sourcePage               String?
  latitude                 Float?
  longitude                Float?
  address                  String?
  hostTownSlug             String?
  coordQuality             String?
  coordSource              String?
  categoryId               String?
  category                 OrganisationCategory?      @relation(fields: [categoryId], references: [id])
  servicesJson             Json                       @default("[]")
  skillsJson               Json                       @default("[]")
  technologiesJson         Json                       @default("[]")
  certificationsJson       Json                       @default("[]")
  serviceAreasJson         Json                       @default("[]")
  industrySectorsJson      Json                       @default("[]")
  portfolioJson            Json                       @default("[]")
  companySize              String?
  cipcNumber               String?
  beeLevel                 String?
  aliasesJson              Json                       @default("[]")
  sourceConfidence         String?
  confidenceScore          Float?
  mergedIntoId             String?
  mergedInto               Organisation?              @relation("OrganisationMergeTarget", fields: [mergedIntoId], references: [id])
  mergedFrom               Organisation[]             @relation("OrganisationMergeTarget")
  provinceId               String?
  province                 Province?                  @relation(fields: [provinceId], references: [id])
  verified                 Boolean                    @default(false)
  verifiedAt               DateTime?
  lastVerifiedAt           DateTime?
  verificationExpiresAt    DateTime?
  verificationTier         String                     @default("unverified")
  verificationSource       String?
  verificationEvidenceJson Json                       @default("[]")
  canonicalKey             String?                    @unique
  externalId               String?
  sourceVersion            String?
  sourceUrl                String?
  retrievedAt              DateTime?
  status                   RecordStatus               @default(DRAFT)
  users                    User[]
  locations                Location[]
  fundingCalls             FundingCall[]
  events                   EcosystemEvent[]
  programmes               Programme[]
  procurements             Procurement[]
  submissions              Submission[]
  relationshipsFrom        OrganisationRelationship[] @relation("RelationshipSource")
  relationshipsTo          OrganisationRelationship[] @relation("RelationshipTarget")
  claims                   OrganisationClaim[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@index([provinceId, status])
  @@index([status])
  @@index([categoryId])
  @@index([verificationExpiresAt])
  @@index([verificationTier])
  @@index([externalId])
}

model OrganisationCategory {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String         @unique
  description   String?
  organisations Organisation[]
}

model OrganisationRelationship {
  id           String           @id @default(cuid())
  sourceId     String
  source       Organisation     @relation("RelationshipSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId     String
  target       Organisation     @relation("RelationshipTarget", fields: [targetId], references: [id], onDelete: Cascade)
  type         RelationshipType
  status       RecordStatus     @default(DRAFT)
  evidenceJson Json             @default("[]")
  validFrom    DateTime?
  validUntil   DateTime?
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([sourceId, targetId, type])
  @@index([targetId, type, status])
  @@index([sourceId, type, status])
}

model OrganisationClaim {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  claimantId     String
  claimant       User         @relation(fields: [claimantId], references: [id], onDelete: Cascade)
  status         ClaimStatus  @default(PENDING)
  evidenceJson   Json         @default("[]")
  reviewedById   String?
  reviewedAt     DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, claimantId, status])
  @@index([status, createdAt])
}

model SourceRecord {
  id            String    @id @default(cuid())
  locationId    String?
  location      Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  title         String
  url           String?
  sourceUrl     String?
  documentRef   String?
  notes         String?
  sourceVersion String?
  etag          String?
  contentHash   String?
  confidence    String?
  connector     String?
  retrievedAt   DateTime?
  licence       String?
  capturedById  String?
  capturedBy    User?     @relation(fields: [capturedById], references: [id])
  capturedAt    DateTime  @default(now())

  @@index([locationId])
}

model ExternalIdentity {
  id         String   @id @default(cuid())
  connector  String
  externalId String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([connector, externalId, entityType])
  @@index([entityType, entityId])
}

model FundingCall {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String
  description    String?
  amount         String?
  fundingType    String?
  minAmount      String?
  maxAmount      String?
  eligibleSectorsJson Json     @default("[]")
  businessStage  String?
  geography      String?
  ownershipCriteria String?
  applicationRequirements String?
  instrument     String?
  openingDate    DateTime?
  deadline       DateTime?
  url            String?
  status         RecordStatus  @default(DRAFT)
  provinceId     String?
  province       Province?     @relation(fields: [provinceId], references: [id])
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  tagsJson       Json          @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  publishedAt    DateTime?

  @@index([provinceId, status])
  @@index([deadline])
}

model EcosystemEvent {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  venue          String?
  onlineUrl      String?
  latitude       Float?
  longitude      Float?
  status         RecordStatus  @default(DRAFT)
  provinceId     String?
  province       Province?     @relation(fields: [provinceId], references: [id])
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  tagsJson       Json          @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([provinceId, status])
  @@index([startsAt])
}

model Programme {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String
  description    String?
  status         RecordStatus  @default(DRAFT)
  provinceId     String?
  province       Province?     @relation(fields: [provinceId], references: [id])
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  tagsJson       Json          @default("[]")
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([provinceId, status])
}

model Procurement {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String
  description    String?
  closingDate    DateTime?
  budget         String?
  referenceNumber String?
  issuingAuthority String?
  procurementCategory String?
  briefingAt     DateTime?
  closingTime    String?
  valueRange     String?
  documentsJson  Json          @default("[]")
  url            String?
  status         RecordStatus  @default(DRAFT)
  provinceId     String?
  province       Province?     @relation(fields: [provinceId], references: [id])
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  tagsJson       Json          @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([provinceId, status])
  @@index([closingDate])
}

model Submission {
  id                String           @id @default(cuid())
  type              String
  payloadJson       Json
  payloadHash       String?
  status            SubmissionStatus @default(SUBMITTED)
  submitterName     String
  submitterEmail    String
  notes             String?
  reviewedNotes     String?
  provinceId        String?
  province          Province?        @relation(fields: [provinceId], references: [id])
  organisationId    String?
  organisation      Organisation?    @relation(fields: [organisationId], references: [id])
  submittedById     String?
  submittedBy       User?            @relation("SubmissionSubmitter", fields: [submittedById], references: [id])
  reviewedById      String?
  reviewedBy        User?            @relation("SubmissionReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  createdLocationId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([provinceId, status])
  @@index([payloadHash])
  @@index([submitterEmail, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  action         String
  entityType     String
  entityId       String?
  metadataJson   Json?
  ipAddress      String?
  provinceId     String?
  organisationId String?
  createdAt      DateTime @default(now())

  @@index([provinceId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model AnalyticsEvent {
  id           String   @id @default(cuid())
  eventType    String
  path         String?
  provinceId   String?
  locationId   String?
  metadataJson Json?
  createdAt    DateTime @default(now())

  @@index([provinceId, createdAt])
  @@index([eventType, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AdminInvitation {
  id             String    @id @default(cuid())
  email          String
  role           UserRole
  provinceId     String?
  organisationId String?
  tokenHash      String    @unique
  invitedById    String?
  invitedBy      User?     @relation("InvitationInviter", fields: [invitedById], references: [id])
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([email])
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model BackupRecord {
  id             String    @id @default(cuid())
  filename       String
  path           String
  sizeBytes      Int
  kind           String    @default("app-export")
  notes          String?
  checksumSha256 String?
  objectsCopied  Int       @default(0)
  lastVerifiedAt DateTime?
  rpoMinutes     Int?
  rtoMinutes     Int?
  cursorJson     Json?
  createdById    String?
  createdAt      DateTime  @default(now())

  @@index([kind, createdAt])
}

model StoredObject {
  id             String   @id @default(cuid())
  filename       String
  url            String
  contentType    String
  sizeBytes      Int
  sha256         String
  access         String   @default("private")
  driver         String   @default("local")
  organisationId String?
  uploadedById   String?
  createdAt      DateTime @default(now())

  @@index([organisationId])
  @@index([sha256])
}

model DataSubjectRequest {
  id             String         @id @default(cuid())
  type           String
  status         WorkflowStatus @default(OPEN)
  requesterEmail String
  requesterName  String?
  details        String?
  provinceId     String?
  handledNotes   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, createdAt])
}

model CorrectionRequest {
  id             String         @id @default(cuid())
  targetType     String
  targetId       String?
  targetSlug     String?
  status         WorkflowStatus @default(OPEN)
  submitterName  String
  submitterEmail String
  message        String
  provinceId     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, createdAt])
}

model ImportBatch {
  id             String       @id @default(cuid())
  source         String
  sourceUrl      String?
  sourceVersion  String?
  checksumSha256 String?
  licence        String?
  status         ImportStatus @default(STAGED)
  provinceId     String?
  rowCount       Int          @default(0)
  appliedCount   Int          @default(0)
  payloadJson    Json
  reportJson     Json?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  appliedAt      DateTime?

  @@index([status, createdAt])
  @@index([provinceId])
}

model IngestionChange {
  id          String   @id @default(cuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  connector   String
  action      String
  canonicalKey String?
  beforeJson  Json     @default("{}")
  afterJson   Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([locationId, createdAt])
  @@index([connector, createdAt])
}

model Translation {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  field      String
  locale     String
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, field, locale])
  @@index([locale, entityType])
}

model Notification {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String?
  type         String
  subject      String
  body         String
  status       JobStatus @default(PENDING)
  attempts     Int       @default(0)
  scheduledAt  DateTime  @default(now())
  sentAt       DateTime?
  lastError    String?
  metadataJson Json?
  channel      String    @default("email")
  provider     String?
  bouncedAt    DateTime?
  receiptId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  email     Boolean  @default(true)
  inApp     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventType])
}

model BackgroundJob {
  id             String    @id @default(cuid())
  type           String
  status         JobStatus @default(PENDING)
  payloadJson    Json
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAfter       DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  completedAt    DateTime?
  idempotencyKey String?   @unique
  deadLetter     Boolean   @default(false)
  maxRuntimeMs   Int       @default(300000)
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([type, createdAt])
  @@index([leaseExpiresAt])
}

model ApiKey {
  id             String    @id @default(cuid())
  name           String
  prefix         String    @unique
  keyHash        String    @unique
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  organisationId String?
  scopesJson     Json      @default("[]")
  rateLimit      Int       @default(600)
  active         Boolean   @default(true)
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  allowedCidrsJson Json      @default("[]")
  rotatedFromId    String?
  createdAt        DateTime  @default(now())

  @@index([organisationId, active])
}

model MfaRecoveryRequest {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation("MfaRecoverySubject", fields: [userId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    User      @relation("MfaRecoveryRequester", fields: [requestedById], references: [id])
  approvedById   String?
  approvedBy     User?     @relation("MfaRecoveryApprover", fields: [approvedById], references: [id])
  reason         String
  status         String    @default("PENDING")
  tokenHash      String?   @unique
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

model SearchSynonym {
  id           String   @id @default(cuid())
  term         String
  locale       String   @default("en")
  synonymsJson Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([term, locale])
}

model WorkerHeartbeat {
  id          String   @id @default(cuid())
  workerId    String   @unique
  lastSeenAt  DateTime
  queueDepth  Int      @default(0)
  createdAt   DateTime @default(now())
}

model OrganisationMerge {
  id            String   @id @default(cuid())
  sourceId      String
  targetId      String
  performedById String?
  payloadJson   Json
  createdAt     DateTime @default(now())

  @@index([targetId, createdAt])
}
