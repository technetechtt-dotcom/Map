// PostgreSQL / PostGIS production path
//
// 1. Start services: docker compose up -d (PostGIS on 5433 by default)
// 2. Set DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ictmap
// 3. Point schema.prisma datasource to postgresql (or use dual deploy pipeline)
// 4. Apply: psql $DATABASE_URL -f prisma/migrations/20260326_postgis_init.sql
// 5. Seed with strong SEED_ADMIN_PASSWORD (never commit secrets)
//
// Full models live in schema.prisma — this file only documents the postgres datasource.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
